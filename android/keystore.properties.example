# Copiar a android/keystore.properties (NO versionado, ver .gitignore) y completar
# con los datos reales del keystore de release. Generar el keystore con:
#
#   cd android
#   keytool -genkeypair -v -storetype PKCS12 -keystore release.keystore \
#     -alias tratofacilv2-release -keyalg RSA -keysize 2048 -validity 10000
#
# Guardar release.keystore y estas credenciales en un lugar seguro (gestor de
# secretos del equipo). Perder el keystore significa no poder volver a publicar
# actualizaciones de la app con la misma identidad una vez esté en la store.

storeFile=release.keystore
storePassword=
keyAlias=tratofacilv2-release
keyPassword=
